@model IssuedDocument
@{ViewData["Title"]="QR verifikacija";}
<div class="row justify-content-center"><div class="col-lg-7"><div class="verify-card"><div class="verify-check">✓</div><div class="eyebrow">QR PROVJERA • DEMO</div><h1>Demo zapis pronađen</h1><p class="text-secondary">QR token odgovara zapisu u demonstracionoj bazi.</p><hr/><div class="verify-row"><span>Vrsta usluge</span><strong>@Model.ServiceRequest?.AdministrativeService?.Name</strong></div><div class="verify-row"><span>Referenca dokumenta</span><strong>@Model.DocumentReference</strong></div><div class="verify-row"><span>Datum izdavanja</span><strong>@Model.IssuedAt.ToLocalTime().ToString("dd.MM.yyyy.")</strong></div><div class="alert alert-warning mt-4 mb-0">Ova provjera potvrđuje samo postojanje demo zapisa. Ne potvrđuje autentičnost niti pravnu valjanost javne isprave.</div></div></div></div>
