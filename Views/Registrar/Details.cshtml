@model ServiceRequest
@{ViewData["Title"]="Obrada zahtjeva";}
<div class="page-heading"><div><div class="eyebrow">OBRADA PREDMETA</div><h1>@Model.Reference</h1><p>@Model.AdministrativeService?.Name</p></div><a asp-action="Index" class="btn btn-outline-secondary">Nazad na listu</a></div>
<div class="row g-3"><div class="col-lg-7"><div class="panel"><div class="d-flex justify-content-between"><h2 class="h5">Podaci zahtjeva</h2><span class="status status-@Model.Status.ToString().ToLowerInvariant()">@RequestWorkflowService.StatusText(Model.Status)</span></div><hr/><p><strong>Građanin:</strong> @Model.Citizen?.FullName (@Model.Citizen?.Email)</p><p><strong>Datum:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")</p><p><strong>Napomena:</strong><br/>@Model.ApplicantNote</p><h3 class="h6 mt-4">Prilozi</h3>@if(Model.Attachments.Any()){foreach(var a in Model.Attachments){<div class="attachment-row">@a.OriginalName <a asp-action="Attachment" asp-route-id="@a.Id">Preuzmi prilog</a></div>}}else{<p class="text-secondary">Nema priloga.</p>}<div class="alert alert-warning small mt-3">Prilozi u demo verziji se čuvaju privatno na serveru; pregled autentičnosti nije implementiran.</div></div></div>
<div class="col-lg-5"><div class="panel"><h2 class="h5">Ažuriraj status</h2><form asp-action="UpdateStatus" method="post"><input type="hidden" name="Id" value="@Model.Id"/><div class="mb-3"><label class="form-label">Novi status</label><select name="Status" class="form-select" required><option value="">Odaberite</option>@foreach(var s in Enum.GetValues<RequestStatus>()){<option value="@s">@RequestWorkflowService.StatusText(s)</option>}</select></div><div class="mb-3"><label class="form-label">Poruka građaninu</label><textarea name="Note" class="form-control" rows="4" placeholder="Obrazloženje ili upute za dopunu..."></textarea></div><button class="btn btn-primary w-100">Sačuvaj promjenu</button></form><p class="small text-secondary mt-3 mb-0">Dozvoljene promjene statusa se provjeravaju na serveru. Odobravanje kreira demonstracioni dokument.</p></div><div class="panel mt-3"><h3 class="h6">Plaćanje</h3>@if(Model.Payment is null){<p class="text-secondary mb-0">Za ovu uslugu nema evidentirane demo takse.</p>}else{<p class="mb-1">@Model.Payment.Amount.ToString("0.00") KM</p><span class="status status-@Model.Payment.Status.ToLowerInvariant()">@Model.Payment.Status (demo)</span>}</div></div></div>
