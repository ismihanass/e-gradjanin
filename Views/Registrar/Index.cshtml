@model List<ServiceRequest>
@{ViewData["Title"]="Šalterski portal";}
<div class="page-heading"><div><div class="eyebrow">SLUŽBENIČKI PORTAL</div><h1>Pristigli zahtjevi</h1><p>Pregled i obrada predmeta. Odluke donosi ovlašteni službenik.</p></div><div class="role-chip">ŠALTER</div></div>
<div class="panel mb-3"><form method="get" class="row g-2"><div class="col-md-6"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Pretraga po referenci ili e-mailu"/></div><div class="col-md-4"><select name="status" class="form-select"><option value="">Svi statusi</option>@foreach(var s in Enum.GetValues<RequestStatus>()){<option value="@s" selected="@(ViewBag.Status?.ToString()==s.ToString())">@RequestWorkflowService.StatusText(s)</option>}</select></div><div class="col-md-2"><button class="btn btn-primary w-100">Filtriraj</button></div></form></div>
<div class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Referenca</th><th>Građanin</th><th>Usluga</th><th>Datum</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td class="fw-semibold">@x.Reference</td><td>@x.Citizen?.FullName<br/><small class="text-secondary">@x.Citizen?.Email</small></td><td>@x.AdministrativeService?.Name</td><td>@x.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy.")</td><td><span class="status status-@x.Status.ToString().ToLowerInvariant()">@RequestWorkflowService.StatusText(x.Status)</span></td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">Otvori</a></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><h3>Nema pronađenih zahtjeva</h3><p>Promijenite filter ili sačekajte nove zahtjeve.</p></div>}</div>
