@{ ViewData["Title"]="Digitalni šalter"; var services=ViewBag.Services as List<AdministrativeService> ?? new(); }
<section class="hero p-4 p-lg-5 mb-4"><div class="row align-items-center"><div class="col-lg-8"><div class="eyebrow">DIGITALNE JAVNE USLUGE • FBiH</div><h1>Vaši administrativni poslovi.<br/><span>Jednostavnije na jednom mjestu.</span></h1><p class="lead mt-3">Podnesite demo zahtjev, pratite njegov status i pristupite digitalnom arhivu — bez odlaska na šalter u ovoj demonstraciji.</p><div class="d-flex flex-wrap gap-2 mt-4"><a class="btn btn-light btn-lg" asp-controller="Requests" asp-action="Create">Podnesi zahtjev <span aria-hidden="true">→</span></a><a class="btn btn-outline-light btn-lg" href="#usluge">Pregled usluga</a></div></div><div class="col-lg-4 d-none d-lg-block"><div class="hero-art"><div class="hero-icon">✓</div><div class="hero-label">Digitalni šalter</div><div class="hero-line"></div><div class="hero-mini">Sigurno. Pregledno. Dostupno.</div></div></div></div></section>
@if(User.Identity?.IsAuthenticated==true){<div class="row g-3 mb-4"><div class="col-md-6"><div class="stat-card"><div class="stat-label">Moji zahtjevi</div><div class="stat-value">@ViewBag.MyCount</div><a asp-controller="Requests" asp-action="Index">Pregledaj zahtjeve →</a></div></div><div class="col-md-6"><div class="stat-card"><div class="stat-label">Aktivni predmeti</div><div class="stat-value">@ViewBag.PendingCount</div><span class="text-secondary small">Zahtjevi koji još nisu završeni</span></div></div></div>}
<div class="section-heading" id="usluge"><div><div class="eyebrow">KATALOG</div><h2>Dostupne usluge</h2><p>Odaberite uslugu i započnite popunjavanje zahtjeva.</p></div></div>
<div class="row g-3">@foreach(var s in services){<div class="col-md-6 col-xl-3"><div class="service-card h-100"><div class="service-icon">▤</div><div class="small text-primary fw-semibold">@s.Category</div><h3>@s.Name</h3><p>@s.Description</p><div class="service-meta"><span>@(s.Fee==0?"Bez demo naknade":$"{s.Fee:0.00} KM")</span><span>~ @s.EstimatedDays dana*</span></div><a class="stretched-link" asp-controller="Requests" asp-action="Create" asp-route-serviceId="@s.Id">Podnesi zahtjev →</a></div></div>}</div>
<p class="small text-secondary mt-3">* Prikazano trajanje je ilustrativno, nije zakonski rok niti garancija. Ova aplikacija je prototip i ne izdaje službene dokumente.</p>
<div class="row g-3 mt-4"><div class="col-md-4"><div class="feature-card"><strong>01</strong><h3>Podnošenje online</h3><p>Odaberite uslugu, unesite podatke i dodajte priloge.</p></div></div><div class="col-md-4"><div class="feature-card"><strong>02</strong><h3>Praćenje statusa</h3><p>Pratite kretanje zahtjeva i poruke službenika.</p></div></div><div class="col-md-4"><div class="feature-card"><strong>03</strong><h3>Digitalni arhiv</h3><p>Preuzmite demonstracioni PDF i provjerite QR kod.</p></div></div></div>
