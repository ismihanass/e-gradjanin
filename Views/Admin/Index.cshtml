@{ViewData["Title"]="Administracija";}
<div class="page-heading"><div><div class="eyebrow">KONTROLNI CENTAR</div><h1>Administracija sistema</h1><p>Osnovni pregled rada demonstracione platforme.</p></div><div class="role-chip">ADMIN</div></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="stat-card"><div class="stat-label">Korisnici</div><div class="stat-value">@ViewBag.Users</div></div></div><div class="col-6 col-xl-3"><div class="stat-card"><div class="stat-label">Ukupno zahtjeva</div><div class="stat-value">@ViewBag.Requests</div></div></div><div class="col-6 col-xl-3"><div class="stat-card"><div class="stat-label">Aktivni predmeti</div><div class="stat-value">@ViewBag.Open</div></div></div><div class="col-6 col-xl-3"><div class="stat-card"><div class="stat-label">Demo dokumenti</div><div class="stat-value">@ViewBag.Documents</div></div></div></div>
<div class="row g-3"><div class="col-md-4"><a class="admin-link" asp-action="UsersList"><span>♙</span><strong>Korisnici i uloge</strong><small>Upravljanje pristupom</small></a></div><div class="col-md-4"><a class="admin-link" asp-action="Services"><span>▤</span><strong>Katalog usluga</strong><small>Aktiviranje i deaktiviranje usluga</small></a></div><div class="col-md-4"><a class="admin-link" asp-action="Audit"><span>◷</span><strong>Revizijski trag</strong><small>Pregled sistemskih događaja</small></a></div></div>
<div class="panel mt-4"><h2 class="h5">Nedavni zahtjevi</h2><div class="table-responsive"><table class="table"><thead><tr><th>Referenca</th><th>Usluga</th><th>Status</th><th>Datum</th></tr></thead><tbody>@foreach(var x in (List<ServiceRequest>)ViewBag.Recent){<tr><td>@x.Reference</td><td>@x.AdministrativeService?.Name</td><td>@RequestWorkflowService.StatusText(x.Status)</td><td>@x.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy.")</td></tr>}</tbody></table></div></div>
