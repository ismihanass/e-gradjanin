@model List<ServiceRequest>
@{ViewData["Title"]="Moji zahtjevi";}
<div class="page-heading"><div><div class="eyebrow">GRAĐANSKI PORTAL</div><h1>Moji zahtjevi</h1><p>Pregled svih zahtjeva koje ste podnijeli.</p></div><a class="btn btn-primary" asp-action="Create">+ Novi zahtjev</a></div>
@if(ViewBag.Notifications is List<UserNotification> notes && notes.Any()){<div class="panel mb-3"><h2 class="h6">Obavještenja</h2>@foreach(var n in notes){<div class="attachment-row"><span class="text-secondary small">@n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")</span> — @n.Message</div>}</div>}
<div class="panel">@if(!Model.Any()){<div class="empty-state"><div class="empty-icon">▤</div><h3>Još nemate zahtjeva</h3><p>Kada podnesete zahtjev, pojavit će se na ovoj stranici.</p><a class="btn btn-primary" asp-action="Create">Podnesi prvi zahtjev</a></div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Referentni broj</th><th>Usluga</th><th>Datum</th><th>Status</th><th>Plaćanje</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td class="fw-semibold">@x.Reference</td><td>@x.AdministrativeService?.Name</td><td>@x.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy.")</td><td><span class="status status-@x.Status.ToString().ToLowerInvariant()">@RequestWorkflowService.StatusText(x.Status)</span></td><td>@(x.Payment is null?"—":x.Payment.Status=="Paid"?"Plaćeno (demo)":"Na čekanju")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Detalji</a></td></tr>}</tbody></table></div>}</div>
