@model ServiceRequest
@{ViewData["Title"]="Detalji zahtjeva";}
<div class="page-heading"><div><div class="eyebrow">PREDMET @Model.Reference</div><h1>Detalji zahtjeva</h1><p>Podneseno @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy. u HH:mm")</p></div><a asp-action="Index" class="btn btn-outline-secondary">Svi zahtjevi</a></div>
<div class="row g-3"><div class="col-lg-8"><div class="panel"><div class="d-flex justify-content-between align-items-start gap-3"><div><div class="text-secondary small">USLUGA</div><h2 class="h4">@Model.AdministrativeService?.Name</h2></div><span class="status status-@Model.Status.ToString().ToLowerInvariant()">@RequestWorkflowService.StatusText(Model.Status)</span></div><hr/><div class="text-secondary small">NAPOMENA</div><p>@Model.ApplicantNote</p><div class="text-secondary small mt-4">PRILOZI</div>@if(Model.Attachments.Any()){foreach(var a in Model.Attachments){<div class="attachment-row">▧ @a.OriginalName <a asp-action="Attachment" asp-route-id="@a.Id">Preuzmi</a></div>}}else{<p class="text-secondary">Nema priloženih datoteka.</p>}@if(!string.IsNullOrWhiteSpace(Model.RegistrarNote)){<div class="alert alert-info mt-3"><strong>Poruka službenika</strong><br/>@Model.RegistrarNote</div>}</div>
@if(Model.IssuedDocument is not null){<div class="panel mt-3"><div class="eyebrow">DIGITALNI ARHIV</div><h3 class="h5">Dokument je pripremljen</h3><p>Referenca: <strong>@Model.IssuedDocument.DocumentReference</strong></p><a class="btn btn-primary" asp-controller="Documents" asp-action="Download" asp-route-id="@Model.IssuedDocument.Id">Preuzmi demo PDF</a><p class="small text-warning mt-3 mb-0">Demo PDF nije javna isprava i nema pravnu snagu službenog dokumenta.</p></div>}</div>
<div class="col-lg-4"><div class="panel"><div class="eyebrow">PREGLED</div><div class="timeline"><div class="timeline-step active"><strong>Zahtjev zaprimljen</strong><small>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy.")</small></div><div class="timeline-step @(Model.Status!=RequestStatus.Submitted?"active":"")"><strong>Obrada</strong><small>@(Model.Status==RequestStatus.Submitted?"Čeka pregled":"Status ažuriran")</small></div><div class="timeline-step @(Model.Status==RequestStatus.Approved||Model.Status==RequestStatus.Completed?"active":"")"><strong>Odluka</strong><small>@RequestWorkflowService.StatusText(Model.Status)</small></div></div>@if(Model.Payment is not null){<hr/><div class="d-flex justify-content-between"><span>Demo taksa</span><strong>@Model.Payment.Amount.ToString("0.00") KM</strong></div><p class="small text-secondary">Status: @Model.Payment.Status</p>@if(Model.Payment.Status!="Paid"){<form asp-action="SimulatePayment" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-outline-primary w-100">Simuliraj uplatu</button></form>}else{<span class="badge text-bg-success">Uplata evidentirana (demo)</span>}}</div></div></div>
