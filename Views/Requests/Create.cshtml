@model RequestCreateViewModel
@{ViewData["Title"]="Novi zahtjev"; var services=ViewBag.Services as List<AdministrativeService> ?? new();}
<div class="page-heading"><div><div class="eyebrow">DIGITALNI ŠALTER</div><h1>Podnošenje zahtjeva</h1><p>Popunite podatke i priložite dokumentaciju.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Nazad</a></div>
<div class="row justify-content-center"><div class="col-lg-8"><div class="panel"><form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="ServiceId" class="form-label">Administrativna usluga</label><select asp-for="ServiceId" class="form-select"><option value="0">— Odaberite uslugu —</option>@foreach(var s in services){<option value="@s.Id">@s.Name — @(s.Fee==0?"bez naknade":$"{s.Fee:0.00} KM")</option>}</select><span asp-validation-for="ServiceId" class="text-danger"></span></div><div class="mb-3"><label asp-for="ApplicantNote" class="form-label">Napomena / dodatne informacije</label><textarea asp-for="ApplicantNote" class="form-control" rows="5" placeholder="Opišite svrhu zahtjeva ili navedite dodatne informacije..."></textarea><span asp-validation-for="ApplicantNote" class="text-danger"></span></div><div class="mb-3"><label asp-for="Attachment" class="form-label">Prilog (opcionalno)</label><input asp-for="Attachment" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"/><div class="form-text">PDF, JPG ili PNG • maksimalno 10 MB. Ne učitavajte stvarne osjetljive dokumente u demo okruženje.</div><span asp-validation-for="Attachment" class="text-danger"></span></div><div class="alert alert-warning small">Ovo je demonstracioni sistem. Podnošenje zahtjeva ne pokreće stvarni upravni postupak. AI i sistem ne potvrđuju autentičnost priloga.</div><div class="d-flex justify-content-end"><button class="btn btn-primary btn-lg">Pošalji demo zahtjev</button></div></form></div></div></div>
