<!DOCTYPE html>
<html lang="bs">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - eGrađanin FBiH</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head><body>
<div class="demo-strip">DEMO OKRUŽENJE <span>•</span> Nema povezivanja sa državnim registrima niti stvarnog plaćanja</div>
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top"><div class="container"><a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">e</span> Građanin <small>FBiH</small></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto">
<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Početna</a></li><li class="nav-item"><a class="nav-link" asp-controller="AI" asp-action="Index">AI asistent</a></li>
@if(User.Identity?.IsAuthenticated==true){<li class="nav-item"><a class="nav-link" asp-controller="Requests" asp-action="Index">Moji zahtjevi</a></li>}
@if(User.IsInRole("Registrar")||User.IsInRole("Administrator")){<li class="nav-item"><a class="nav-link" asp-controller="Registrar" asp-action="Index">Šalter</a></li>}
@if(User.IsInRole("Administrator")){<li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Administracija</a></li>}
</ul><div class="d-flex align-items-center gap-2">
@if(User.Identity?.IsAuthenticated==true){<span class="small text-secondary d-none d-md-inline">@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm">Odjava</button></form>}
else{<a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Prijava</a><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Registracija</a>}
</div></div></div></nav>
<main class="container py-4">@if(TempData["Success"] is string s){<div class="alert alert-success alert-dismissible fade show">@s<button class="btn-close" data-bs-dismiss="alert"></button></div>}@if(TempData["Error"] is string e){<div class="alert alert-danger">@e</div>}@RenderBody()</main>
<footer class="footer mt-5"><div class="container d-flex flex-wrap justify-content-between gap-2"><span>© @DateTime.Now.Year eGrađanin FBiH — demonstraciona aplikacija</span><span>Privatnost • Sigurnost • Dostupnost</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)
</body></html>
