@model AiQuestionViewModel
@{ViewData["Title"]="AI asistent"; var answer=ViewBag.Answer as AiAnswer;}
<div class="page-heading"><div><div class="eyebrow">POMOĆ I INFORMACIJE</div><h1>AI digitalni asistent</h1><p>Postavite pitanje o korištenju platforme i administrativnim uslugama.</p></div><div class="ai-orb">✦</div></div>
<div class="row justify-content-center"><div class="col-lg-8"><div class="panel ai-panel"><div class="d-flex gap-3 align-items-start"><div class="ai-avatar">✦</div><div><strong>Digitalni asistent</strong><p class="text-secondary small mb-0">Odgovori se zasnivaju na ograničenoj demo bazi znanja. Nisu službeni pravni savjeti.</p></div></div><hr/><div class="prompt-chips"><button type="button" class="btn btn-sm btn-outline-secondary" data-question="Kako mogu podnijeti zahtjev za rodni list?">Kako podnijeti zahtjev?</button><button type="button" class="btn btn-sm btn-outline-secondary" data-question="Kako mogu pratiti status svog zahtjeva?">Praćenje statusa</button><button type="button" class="btn btn-sm btn-outline-secondary" data-question="Kako funkcioniše plaćanje?">Plaćanje</button></div><form method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Question" class="form-label">Vaše pitanje</label><textarea asp-for="Question" class="form-control" rows="3" placeholder="Npr. Kako mogu dobiti uvjerenje o državljanstvu?"></textarea><span asp-validation-for="Question" class="text-danger"></span><button class="btn btn-primary mt-3">Pošalji pitanje</button></form>
@if(answer is not null){<div class="answer-card mt-4"><div class="small fw-bold text-primary mb-2">ODGOVOR ASISTENTA</div><p>@answer.Text</p><div class="small text-secondary">Izvor: @answer.Source</div><div class="small text-warning mt-2">AI odgovor je informativan. Provjerite važeće uslove kod nadležnog organa.</div></div>}</div></div></div>
@section Scripts{<script>document.querySelectorAll('[data-question]').forEach(b=>b.addEventListener('click',()=>document.getElementById('Question').value=b.dataset.question));</script>}
